# Example environment configuration
# Copy this file to .env and customize. Never commit .env to source control!

# Application Environment
APP_ENV=development
DEBUG=False
PORT=8501

# MySQL Database Configuration (Optional - for SQL Star-Schema Integration)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Your_mysql_password
MYSQL_DATABASE=indian_logistics_db
